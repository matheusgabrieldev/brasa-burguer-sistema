# Copie para .env e ajuste. Em produção estas variáveis vêm do servidor.
DEBUG=1
LOAD_DOTENV=1
SECRET_KEY=troque-isto
# O asterisco aceita qualquer Host e serve somente para desenvolvimento local.
ALLOWED_HOSTS=localhost,127.0.0.1,*
# DATABASE_URL=postgres://usuario:senha@host:5432/brasaburguer

# Configure diretamente no servidor, usando segredos próprios.
# DEBUG=0
# LOAD_DOTENV=0
# SECRET_KEY=<segredo-longo-aleatorio>
# DATABASE_URL=postgresql://usuario:senha@host:5432/brasaburguer
# ALLOWED_HOSTS=brasaburguer.com.br,healthcheck.railway.app
# CSRF_TRUSTED_ORIGINS=https://brasaburguer.com.br
# Ative apenas após verificar que o proxy substitui X-Forwarded-For.
# Vale para o freio de pedidos do checkout e para o bloqueio de login (django-axes).
# CONFIAR_X_FORWARDED_FOR=0
